# games.e-ink.me 环境变量样例——复制为 .env.local / .env.production 使用。
#
# 【安全红线】本文件只放变量名与占位注释，禁止写入任何真实 key / 测量 ID
# （此前 news 站 .env.example 提交过真实 API key）。真实值只进本地
# .env*.local（已被 .gitignore 忽略）与 Cloudflare Pages 构建环境变量。

# ── Analytics（全部可选；留空 = 对应脚本完全不注入，页面零请求零痕迹）──

# Google Analytics 4 衡量 ID，形如 G-XXXXXXXXXX（GA4 后台 → 数据流 → 衡量 ID）。
NEXT_PUBLIC_GA4_ID=

# Umami 网站 ID（Umami 后台 → Settings → Websites）。
NEXT_PUBLIC_UMAMI_ID=

# Umami 统计脚本地址（自托管，形如 https://umami.example.com/script.js）。
# 与 NEXT_PUBLIC_UMAMI_ID 成对生效。
NEXT_PUBLIC_UMAMI_SRC=
