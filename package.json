{
  "name": "games-e-ink-me",
  "version": "0.1.0",
  "private": true,
  "description": "Free browser games for Kindle & e-ink readers — static-exported Next.js site",
  "scripts": {
    "dev": "npm run build:games && next dev",
    "build": "npm run build:games && npm run build:games:template && npm run gen:og && next build && npm run gen:sitemap",
    "build:games": "node scripts/build-games.mjs",
    "build:games:template": "node scripts/build-games.mjs --include-template",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "preview": "python3 -m http.server 3000 --directory out",
    "start": "next start",
    "test": "vitest run"
  },
  "dependencies": {
    "@marcomattes/epaper-components": "2.0.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.4",
    "typescript": "^6.0.3",
    "vitest": "5.0.2"
  }
}
